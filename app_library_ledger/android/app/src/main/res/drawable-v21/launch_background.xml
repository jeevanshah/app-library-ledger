<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- launch_background_color resolves to white (light theme default)
         or #0B0B11 (values-night, dark theme) so there's no flash before
         the Flutter splash renders. This -v21 file takes precedence over
         drawable/launch_background.xml on all supported devices (minSdk 24). -->
    <item android:drawable="@color/launch_background_color" />

